# Copy this file to .env.production and replace every change-me value.
ROADLENS_HTTP_PORT=8080

DB_NAME=roadlens
DB_USER=roadlens
DB_PASSWORD=change-me-database-password
DB_ROOT_PASSWORD=change-me-database-root-password

# URL-safe base64 for exactly 32 random bytes.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
ROADLENS_MASTER_KEY=change-me-url-safe-base64-key
ROADLENS_COOKIE_SECURE=true
ROADLENS_CORS_ORIGINS=https://roadlens.example.com
ROADLENS_WORKER_POLL_SECONDS=2

ROADLENS_EMAIL_MODE=smtp
ROADLENS_EMAIL_FROM=RoadLens <roadlens@example.com>
ROADLENS_SMTP_HOST=smtp.example.com
ROADLENS_SMTP_PORT=587
ROADLENS_SMTP_TLS=true
ROADLENS_SMTP_USERNAME=change-me-smtp-user
ROADLENS_SMTP_PASSWORD=change-me-smtp-password
